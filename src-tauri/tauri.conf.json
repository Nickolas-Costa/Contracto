{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contracto",
  "version": "5.6.0",
  "identifier": "br.com.contracto.app",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; frame-src blob:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["../app/assets/icons/app_icon.ico"],
    "resources": { "binaries/sidecar/": "sidecar/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"], "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQUNDMUVBMjcxQUFDNEQKUldSTnJCb242c0dzMmt1V2g5M05udHhLSWNSbWZaNmZOamJ4NElTVW1icGtRY0RUU3hBcVp0b1UK",
      "endpoints": ["https://github.com/Nickolas-Costa/Contracto/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
